    <Grid x:Name="LayoutRoot">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.Background>
            <ImageBrush x:Name="MainBackground"
                    ImageSource="ms-appx:///Images/tnm0ZI.jpg"
                    Stretch="UniformToFill"/>


        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Semi-transparent overlay to “soften” background -->
        <Rectangle Grid.RowSpan="2" x:Name="DimOverlay" Fill="#88000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Grid Grid.Row="0">
            <TextBlock x:Name="TitleText"
           Text="QuoteTile"
           FontFamily="Segoe UI"
           FontWeight="Light"
           FontSize="72"
           Margin="128,24,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top">

                <TextBlock.RenderTransform>
                    <TranslateTransform X="-150"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <StackPanel x:Name="LogoPanel" Orientation="Vertical"
                    HorizontalAlignment="Left"
                    Margin="50,50,0,20">
                <StackPanel.RenderTransform>
                    <TranslateTransform X="-100"/>
                </StackPanel.RenderTransform>
                <Image Source="ms-appx:///Assets/Logo.png"
               Width="50"
               Height="50"
               Stretch="Uniform"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <ScrollViewer
            HorizontalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled"
            ZoomMode="Disabled">
                <StackPanel x:Name="MainPanel" Orientation="Horizontal">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="MainPanelTransform" X="200"/>
                    </StackPanel.RenderTransform>
                    
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="QuoteCard"
                        Background="#AA121216"
                        CornerRadius="14"
                        Padding="36"
                        Margin="60"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="760"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1">

                            <Border.RenderTransform>
                                <CompositeTransform TranslateY="30"/>
                            </Border.RenderTransform>

                            <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="620">

                                <!-- Quote -->
                                <TextBlock x:Name="QuoteText"
                       Text="Loading quote..."
                       TextWrapping="Wrap"
                       FontFamily="Segoe UI"
                       FontWeight="Light"
                       FontSize="28"
                       FontStyle="Italic"
                       TextAlignment="Center"
                       Foreground="White"
                       Margin="0,0,0,16"/>

                                <!-- Author -->
                                <TextBlock x:Name="AuthorText"
                       Text="Loading author..."
                       FontFamily="Segoe UI"
                       FontSize="18"
                       Opacity="0.85"
                       TextAlignment="Right"
                       Foreground="LightGray"
                       Margin="0,0,0,10"/>

                                <ItemsControl x:Name="TagsPanel"
                      HorizontalAlignment="Stretch"
                      Margin="0,8,0,12">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#334CAF50"
                                CornerRadius="10"
                                Padding="10,4"
                                Margin="4">

                                                <TextBlock Text="{Binding}"
                                    FontSize="12"
                                    Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!-- Metadata -->
                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,20">

                                    <TextBlock x:Name="DateAddedText"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Opacity="0.7"
                           Foreground="LightGray"
                           Margin="0,0,20,0"/>

                                    <TextBlock x:Name="DateModifiedText"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Opacity="0.7"
                           Foreground="LightGray"/>
                                </StackPanel>

                                <!-- Divider -->
                                <Rectangle Height="1"
                       Margin="0,0,0,20"
                       Fill="#33FFFFFF"/>

                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Refresh -->
                                    <Button Grid.Column="0" HorizontalAlignment="Center"
                            Click="Refresh_Click"
                            Height="70"
                            Margin="6"
                            Background="#BF1976D2"
                            Foreground="White"
                            BorderBrush="#661976D2"
                            BorderThickness="1">

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe UI Symbol"
                                   Text="⟳"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Refresh"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                                        </StackPanel>

                                    </Button>

                                    <!-- Copy -->
                                    <Button Grid.Column="1" HorizontalAlignment="Center"
                            Click="CopyQuote_Click"
                            Height="70"
                            Margin="6"
                            Background="#BF1976D2"
                            Foreground="White"
                            BorderBrush="#661976D2"
                            BorderThickness="1">

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe UI Symbol"
                                   Text="📄"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Copy"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                                        </StackPanel>

                                    </Button>

                                    <!-- Share -->
                                    <Button Grid.Column="2" HorizontalAlignment="Center"
                            Click="Share_Click"
                            Height="70"
                            Margin="6"
                            Background="#BF1976D2"
                            Foreground="White"
                            BorderBrush="#661976D2"
                            BorderThickness="1">

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe UI Symbol"
                                   Text="↗"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Share"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                                        </StackPanel>

                                    </Button>

                                    <!-- Favorite -->
                                    <Button Grid.Column="3" HorizontalAlignment="Center"
                            Click="Favorite_Click"
                            Height="70"
                            Margin="6"
                            Background="#BF1976D2"
                            Foreground="White"
                            BorderBrush="#661976D2"
                            BorderThickness="1">

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe UI Symbol"
                                   Text="★"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                                            <TextBlock Text="Favorite"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </StackPanel>

                        </Border>
                        <!-- Overlay title attached to QuoteCard -->
