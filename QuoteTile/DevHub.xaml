<Page
    x:Name="pageRoot"
    x:Class="QuoteTile.DevHub"
    DataContext="{Binding DefaultViewModel, RelativeSource={RelativeSource Self}}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuoteTile"
    xmlns:common="using:QuoteTile.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- TODO: Delete this line if the key AppName is declared in App.xaml -->
        <x:String x:Key="AppName">Developers Hub</x:String>
    </Page.Resources>

    <!--
        This grid acts as a root panel for the page that defines two rows:
        * Row 0 contains the back button and page title
        * Row 1 contains the rest of the page layout
    -->
    <Grid x:Name="MainGrid">
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dim overlay covering the whole background -->
        <Rectangle
        Fill="#88000000"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Grid.RowSpan="3"
        IsHitTestVisible="False"/>

        <!-- Back button and page title -->
        <Grid Background="#FF0d47a1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="backButton" Margin="39,59,39,0" Command="{Binding NavigationHelper.GoBackCommand, ElementName=pageRoot}"
                        Style="{StaticResource NavigationBackButtonNormalStyle}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.ItemType="Navigation Button"/>
            <TextBlock x:Name="pageTitle" Text="{StaticResource AppName}" Style="{StaticResource HeaderTextBlockStyle}" Grid.Column="1" 
                        IsHitTestVisible="false" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="0,0,30,40"/>
        </Grid>
        <Grid x:Name="DevGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: Description -->
                <ColumnDefinition Width="360"/>
                <!-- Right: Horizontal scrollable tiles -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE : Description -->
            <Border Grid.Column="0"
            Padding="25"
            Margin="0,0,0,0"
            Background="#88000000">

                <StackPanel>

                    <TextBlock Text="Welcome to the Developers Hub"
                       FontSize="26"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

                    <TextBlock
                Text="This page serves as the central hub for all official QuoteTile community links, developer platforms, and external projects. Here you can explore our Discord communities, content creators, partner platforms, and development resources that help shape the QuoteTile ecosystem. Whether you're looking to stay updated, contribute to development, or discover related projects, everything you need is conveniently gathered here in one place."
                FontSize="15"
                TextWrapping="Wrap"
                Margin="0,8,0,0"/>

                </StackPanel>

            </Border>
            
            <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled"
            ZoomMode="Disabled">
                <StackPanel Orientation="Horizontal">

                    <!-- TILE 1 -->
                    <Button Click="Tile_Click" Tag="https://discord.gg/kYQz5agYt"
                    Background="Transparent" BorderThickness="0" Margin="0,0,20,0">
                        <Border Background="#AA121216" BorderBrush="#22FFFFFF" BorderThickness="1" Width="500" Padding="15" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Image -->
                                <Image Source="ms-appx:///Images/logo.png"
                               Width="160"
                               Height="160"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Left"
                               Margin="0,0,10,0"/>

                                <!-- Text Content -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Geek Devs Comm (GDC)"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Grid.Row="0"/>

                                    <TextBlock Text="Looking for more? Join our Discord Server for updates on QuoteTile, and discover other projects like Project 9600, QuoteTile 2.0, and highlights from GDC!"
                                       FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Grid.Row="1"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </Button>

                    <!-- TILE 2 -->
                    <Button Click="Tile_Click" Tag="https://www.youtube.com/channel/UCuyJDal7T1UhCr-zmQ42orw"
                    Background="Transparent" BorderThickness="0" Margin="0,0,20,0">
                        <Border Background="#AA121216" BorderBrush="#22FFFFFF" BorderThickness="1" Width="500" Padding="15" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="ms-appx:///Images/LogoChris.png"
                               Width="160"
                               Height="160"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Left"
                               Margin="0,0,10,0"/>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="ChrisRLillo's YouTube Channel"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Grid.Row="0"/>

                                    <TextBlock Text="Chris is not just a part of our beloved staff, he also plays rock music! Go check out his YouTube Channel and his music videos! Let's Rock!"
                                       FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Grid.Row="1"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </Button>

                    <!-- TILE 6 -->
                    <Button Click="Tile_Click" Tag="https://discord.gg/DV4zDT8QX5"
                    Background="Transparent" BorderThickness="0" Margin="0,0,20,0">
                        <Border Background="#AA121216" BorderBrush="#22FFFFFF" BorderThickness="1" Width="500" Padding="15" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="ms-appx:///Images/portada_3000_1.png"
                               Width="160"
                               Height="160"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Left"
                               Margin="0,0,10,0"/>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="The Cult (ChrisRLillo's)"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Grid.Row="0"/>

                                    <TextBlock Text="Check out ChrisRLillo's community! This is where you'll find his creative music content, original videos, and updates directly from him, from electric guitar performances and music videos to jams and livestreams. "
                                       FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Grid.Row="1"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                    <!-- TILE 6 -->
                    <Button Click="Tile_Click" Tag="http://api.quotable.io/random"
                    Background="Transparent" BorderThickness="0" Margin="0,0,20,0">
                        <Border Background="#AA121216" BorderBrush="#22FFFFFF" BorderThickness="1" Width="500" Padding="15" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="ms-appx:///Assets/Logo.scale-100.png"
                               Width="160"
                               Height="160"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Left"
                               Margin="0,0,10,0"/>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Open Quotable API"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Grid.Row="0"/>

                                    <TextBlock Text="QuoteTile uses this API for fetching quotes. This API is open source and doesn't require an API key."
                                       FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Grid.Row="1"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
